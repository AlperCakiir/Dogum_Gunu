@model Hafi_Abi_Doğum_Günü.Models.ViewModel.HomeIndexViewModel
@{
    ViewData["Title"] = "Ahmet Hafi'nin Doğum Günü";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body, html {
                width: 100%;
                height: 100vh;
                background-color: #050507;
                color: #f8fafc;
                overflow: hidden;
            }

            .hidden {
                display: none !important;
            }

            .screen {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 24px;
                opacity: 1;
                transition: opacity 0.7s ease, transform 0.7s ease;
                overflow-y: auto;
            }

            .fade-out {
                opacity: 0 !important;
                transform: scale(1.03);
                pointer-events: none;
            }

            /* SİNEMATİK DOĞUM GÜNÜ AÇILIŞ EKRANI */
            #step-splash {
                position: fixed;
                inset: 0;
                width: 100%;
                height: 100vh;
                height: 100dvh;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 24px 16px;
                cursor: pointer;
                isolation: isolate;
                background: radial-gradient( ellipse at 50% 36%, rgba(105, 128, 133, 0.52) 0%, rgba(54, 77, 87, 0.35) 34%, transparent 65% ), radial-gradient( circle at 17% 24%, rgba(218, 159, 79, 0.17), transparent 25% ), radial-gradient( circle at 85% 35%, rgba(219, 164, 88, 0.14), transparent 23% ), linear-gradient( 180deg, #314854 0%, #263b45 44%, #151c20 75%, #030405 100% );
            }

                #step-splash::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    z-index: 3;
                    pointer-events: none;
                    background: linear-gradient( to bottom, transparent 35%, rgba(5, 7, 9, 0.08) 48%, rgba(4, 5, 7, 0.68) 75%, #030405 100% );
                }

            .bokeh-dot {
                position: absolute;
                z-index: 1;
                border-radius: 50%;
                pointer-events: none;
                background: radial-gradient( circle, rgba(255, 220, 151, 0.95) 0%, rgba(255, 183, 74, 0.65) 12%, rgba(231, 163, 65, 0.22) 36%, transparent 72% );
                filter: blur(2px);
                animation: goldenGlow 4s ease-in-out infinite alternate;
            }

                .bokeh-dot:nth-child(2) {
                    animation-delay: -1s;
                }

                .bokeh-dot:nth-child(3) {
                    animation-delay: -2.5s;
                }

                .bokeh-dot:nth-child(4) {
                    animation-delay: -1.7s;
                }

            @@keyframes goldenGlow {
                from {
                    opacity: 0.45;
                    transform: scale(0.85);
                }

                to {
                    opacity: 1;
                    transform: scale(1.12);
                }
            }

            .splash-center-wrap {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 560px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                transform: translateY(-8px);
            }

            .brush-stroke-bg {
                position: absolute;
                z-index: 0;
                width: clamp(230px, 39vw, 370px);
                height: clamp(210px, 35vh, 300px);
                top: 2%;
                left: 50%;
                transform: translateX(-50%) rotate(-5deg);
                background: linear-gradient( 135deg, rgba(13, 24, 30, 0.92), rgba(22, 36, 43, 0.72) );
                clip-path: polygon( 15% 19%, 23% 12%, 25% 5%, 35% 10%, 43% 1%, 49% 9%, 59% 0%, 62% 12%, 74% 6%, 71% 17%, 84% 13%, 80% 27%, 92% 31%, 84% 42%, 96% 49%, 86% 58%, 92% 70%, 78% 73%, 82% 88%, 68% 83%, 59% 98%, 49% 88%, 38% 96%, 35% 85%, 21% 91%, 24% 78%, 9% 79%, 17% 65%, 4% 58%, 15% 48%, 7% 37%, 19% 32% );
                filter: blur(1px);
                opacity: 0.95;
            }

            .photo-wrapper {
                position: relative;
                z-index: 2;
                width: clamp(210px, 31vw, 285px);
                height: clamp(260px, 43vh, 345px);
                overflow: visible;
            }

                .photo-wrapper img {
                    display: block;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    object-position: center 35%;
                    border: none;
                    border-radius: 0;
                    box-shadow: none;
                    -webkit-mask-image: radial-gradient( ellipse 68% 72% at 50% 46%, #000 44%, rgba(0, 0, 0, 0.94) 59%, rgba(0, 0, 0, 0.55) 76%, transparent 100% );
                    mask-image: radial-gradient( ellipse 68% 72% at 50% 46%, #000 44%, rgba(0, 0, 0, 0.94) 59%, rgba(0, 0, 0, 0.55) 76%, transparent 100% );
                    filter: brightness(0.96) contrast(1.04) saturate(0.88);
                }

            .splash-text-group {
                position: relative;
                z-index: 4;
                width: 100%;
                margin-top: -35px;
                text-align: center;
            }

            .splash-script {
                font-family: 'Alex Brush', cursive;
                font-size: clamp(35px, 5vw, 48px);
                font-weight: 400;
                line-height: 1.15;
                color: #d8d5cc;
                text-shadow: 0 2px 5px rgba(0, 0, 0, 0.8), 0 0 20px rgba(0, 0, 0, 0.5);
            }

            .splash-main-name {
                font-family: 'Cormorant Garamond', serif;
                font-size: clamp(30px, 5.6vw, 54px);
                font-weight: 500;
                letter-spacing: clamp(4px, 1vw, 8px);
                line-height: 1.12;
                color: #dce1e6;
                text-transform: uppercase;
                white-space: nowrap;
                margin-top: 3px;
                text-shadow: 0 4px 14px rgba(0, 0, 0, 0.95), 0 0 28px rgba(0, 0, 0, 0.65);
            }

            .click-hint {
                position: relative;
                z-index: 5;
                margin-top: 27px;
                padding: 10px 14px;
                font-size: 11px;
                font-weight: 500;
                letter-spacing: 2px;
                line-height: 1.8;
                text-align: center;
                text-transform: uppercase;
                color: rgba(230, 232, 230, 0.65);
                animation: hintFade 2.5s ease-in-out infinite;
            }

            @@keyframes hintFade {
                0%, 100% {
                    opacity: 0.5;
                }

                50% {
                    opacity: 1;
                }
            }

            /* 2. SAHNE: DAVETİYE */
            #step-invite {
                background-color: #f9f6f0;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 0;
            }

            .invite-container {
                width: 100%;
                max-width: 520px;
                height: 100vh;
                max-height: 900px;
                background: url('/images/davetiye_bg.jpeg') center/contain no-repeat #f9f6f0;
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                align-items: center;
                padding-bottom: 2px;
            }

            .invite-continue-btn {
                background: #141414;
                color: #f9f6f0;
                border: none;
                padding: 12px 32px;
                border-radius: 999px;
                font-size: 13px;
                font-weight: 800;
                letter-spacing: 1.5px;
                cursor: pointer;
                box-shadow: 0 10px 30px rgba(0,0,0,0.35);
                transition: 0.2s;
                transform: translateY(45px);
            }

                .invite-continue-btn:hover {
                    transform: translateY(43px);
                    background: #292524;
                }

            /* DİĞER SAHNELER */
            .sketch-frame {
                background: #111115;
                border: 3px solid #e2e8f0;
                border-radius: 18px;
                padding: 40px 36px;
                width: 100%;
                max-width: 560px;
                box-shadow: 0 25px 70px rgba(0,0,0,0.95);
                text-align: center;
            }

                .sketch-frame.wide {
                    max-width: 860px;
                }

            .sketch-title {
                font-size: 32px;
                font-weight: 800;
                margin-bottom: 28px;
                color: #ffffff;
            }

            .oval-box-input {
                width: 100%;
                padding: 18px 28px;
                background: #18181e;
                border: 3px solid #e2e8f0;
                border-radius: 999px;
                color: #fff;
                font-size: 17px;
                font-weight: 600;
                text-align: center;
                outline: none;
                margin-bottom: 24px;
            }

                .oval-box-input:focus {
                    border-color: #6366f1;
                }

            .rect-box-btn {
                width: 100%;
                max-width: 340px;
                padding: 16px 28px;
                background: #6366f1;
                border: 3px solid #e2e8f0;
                border-radius: 10px;
                color: #ffffff;
                font-size: 18px;
                font-weight: 800;
                cursor: pointer;
                transition: 0.2s;
            }

                .rect-box-btn:hover:not(:disabled) {
                    background: #4f46e5;
                    transform: translateY(-2px);
                }

                .rect-box-btn:disabled {
                    opacity: 0.45;
                    cursor: not-allowed;
                }

            .oval-choice-btn {
                width: 100%;
                padding: 18px 24px;
                background: #18181e;
                border: 3px solid #e2e8f0;
                border-radius: 999px;
                color: #ffffff;
                font-size: 18px;
                font-weight: 700;
                cursor: pointer;
                margin-bottom: 18px;
                transition: 0.2s;
            }

                .oval-choice-btn:hover {
                    background: #6366f1;
                    border-color: #ffffff;
                    transform: scale(1.02);
                }

            .create-top-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
                margin-bottom: 22px;
                align-items: center;
            }

            .oval-code-box {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 22px;
                background: #18181e;
                border: 3px solid #10b981;
                border-radius: 999px;
                font-size: 17px;
                font-weight: 800;
                color: #34d399;
            }

            .rect-select-box {
                width: 100%;
                padding: 15px 18px;
                background: #18181e;
                border: 3px solid #e2e8f0;
                border-radius: 10px;
                color: #fff;
                font-size: 15px;
                font-weight: 700;
                outline: none;
                cursor: pointer;
            }

            .lobby-top-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
            }

            .lobby-grid {
                display: grid;
                grid-template-columns: 1.15fr 1fr;
                gap: 28px;
                text-align: left;
            }

            .players-table {
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                background: #18181e;
                min-height: 260px;
                padding: 14px;
            }

            .players-table-head {
                display: flex;
                justify-content: space-between;
                padding-bottom: 10px;
                margin-bottom: 8px;
                border-bottom: 2px solid rgba(255,255,255,0.2);
                font-size: 13px;
                font-weight: 800;
                color: #94a3b8;
            }

            .player-row-item {
                display: flex;
                justify-content: space-between;
                padding: 10px 6px;
                border-bottom: 1px solid rgba(255,255,255,0.08);
                font-size: 16px;
                font-weight: 700;
            }

            .game-split-layout {
                display: grid;
                grid-template-columns: 1.45fr 1fr;
                gap: 26px;
                align-items: start;
            }

            .game-left-panel {
                border: 2px solid rgba(255,255,255,0.25);
                border-radius: 14px;
                padding: 22px;
                background: #16161c;
                text-align: left;
            }

            .game-right-panel {
                border: 2px solid rgba(255,255,255,0.25);
                border-radius: 14px;
                padding: 22px;
                background: #16161c;
                min-height: 420px;
            }

            .question-main-box {
                border: 2px solid #e2e8f0;
                border-radius: 12px;
                padding: 20px;
                font-size: 18px;
                font-weight: 800;
                text-align: center;
                margin-bottom: 16px;
                background: #1f1f27;
            }

            .answer-opt-btn {
                width: 100%;
                padding: 13px 16px;
                margin-bottom: 10px;
                background: #18181e;
                border: 2px solid rgba(255,255,255,0.3);
                border-radius: 8px;
                color: #fff;
                font-size: 15px;
                font-weight: 700;
                text-align: left;
                cursor: pointer;
                transition: 0.15s;
            }

                .answer-opt-btn:hover:not(:disabled) {
                    border-color: #6366f1;
                    background: rgba(99,102,241,0.15);
                }

                .answer-opt-btn.selected-opt {
                    border-color: #10b981 !important;
                    background: rgba(16,185,129,0.25) !important;
                    color: #34d399 !important;
                }

            @@media (max-width: 768px) {
                .create-top-row, .lobby-grid, .game-split-layout {
                    grid-template-columns: 1fr;
                }

                .splash-main-name {
                    font-size: 38px;
                    letter-spacing: 4px;
                }
            }
    </style>
</head>
<body>

    <!-- 1. SAHNE: AÇILIŞ -->
    <div id="step-splash" class="screen" onclick="transitionFromSplashToInvite()">
        <div class="bokeh-dot" style="width: 48px; height: 48px; top: 17%; left: 14%;"></div>
        <div class="bokeh-dot" style="width: 78px; height: 78px; top: 42%; left: 3%;"></div>
        <div class="bokeh-dot" style="width: 66px; height: 66px; top: 26%; right: 10%;"></div>
        <div class="bokeh-dot" style="width: 34px; height: 34px; top: 12%; right: 27%;"></div>
        <div class="bokeh-dot" style="width: 42px; height: 42px; top: 61%; right: 19%;"></div>
        <div class="bokeh-dot" style="width: 28px; height: 28px; top: 71%; left: 25%;"></div>

        <div class="splash-center-wrap">
            <div class="brush-stroke-bg"></div>
            <div class="photo-wrapper">
                <img src="/images/Ahmet_Hafi.png" alt="Ahmet Hafi'nin portresi" />
            </div>
            <div class="splash-text-group">
                <div class="splash-script">İyi ki Doğdun</div>
                <div class="splash-main-name">AHMET HAFİ</div>
            </div>
            <div class="click-hint">✦ Davetiyeye geçmek için ekrana dokun ✦</div>
        </div>
    </div>

    <!-- 2. SAHNE: DAVETİYE -->
    <div id="step-invite" class="screen hidden">
        <div class="invite-container">
            <button class="invite-continue-btn" onclick="transitionToWelcome()">
                BİR OYUNA VAR MISIN? ➔
            </button>
        </div>
    </div>

    <!-- 3. SAHNE: HOŞGELDİNİZ -->
    <div id="step-welcome" class="screen hidden">
        <div class="sketch-frame">
            <h2 class="sketch-title">Hoşgeldiniz</h2>
            <input type="text" id="playerNameInput" class="oval-box-input" placeholder="İsminiz / Lakabınız..." maxlength="18" />
            <button class="rect-box-btn" onclick="goToMenuScene()">Hazırım</button>
        </div>
    </div>

    <!-- 4. SAHNE: MENÜ -->
    <div id="step-menu" class="screen hidden">
        <div class="sketch-frame">
            <h2 class="sketch-title">Başlıyoruz...</h2>
            <button class="oval-choice-btn" onclick="openRulesScene()">Nasıl Oynarım</button>
            <button class="oval-choice-btn" onclick="openJoinLobbyScene()">Lobiye Katıl</button>
            <button class="oval-choice-btn" onclick="openCreateLobbyScene()">Lobi Kur</button>
        </div>
    </div>

    <!-- NASIL OYNARIM -->
    <div id="step-rules" class="screen hidden">
        <div class="sketch-frame">
            <h2 class="sketch-title">Nasıl Oynarım?</h2>
            <div style="text-align: left; line-height: 1.7; font-size: 15px; color: #e2e8f0; margin-bottom: 26px; background: #18181e; padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.15);">
                • Lobiyi kuran kişi, soruların kimin üzerine cevaplanacağını (Hedef Kişiyi) seçer.<br><br>
                • <b>Her soru 10 puandır.</b> Hedef kişinin cevabını doğru bilen oyuncular <b>+10 puan</b> kazanır.<br><br>
                • <b>Beni Kim Daha İyi Tanıyor? (Riskli Tahmin):</b> Hedef kişi kendi cevabını kimin doğru tahmin edeceğini seçer:<br>
                &nbsp;&nbsp;✅ Doğru bildiyse: Kendisi <b>+10</b>, bildiğinden <b>+5 bonus</b> alır; karşı taraf da <b>+10 puan</b> alır!<br>
                &nbsp;&nbsp;❌ Bilemediyse: Kendisi <b>-10 puan</b> kaybeder!
            </div>
            <button class="rect-box-btn" onclick="backToMenuScene()">Geri Dön</button>
        </div>
    </div>

    <!-- 5. SAHNE: LOBİ KUR -->
    <div id="step-create-lobby" class="screen hidden">
        <div class="sketch-frame wide">
            <h2 class="sketch-title">Lobi Kurma Yerine Hoşgeldiniz</h2>
            <div class="create-top-row">
                <div class="oval-code-box">
                    <span id="generatedCodeText">------</span>
                    <button onclick="copyLobbyCode()" style="background:#10b981; color:#000; border:none; padding:6px 12px; border-radius:8px; font-weight:800; cursor:pointer;">📋 Kopyala</button>
                </div>
                <select id="lobbyCapacitySelect" class="rect-select-box">
                    <option value="5">Kaç kişi giricek: 5 Kişi</option>
                    <option value="10" selected>Kaç kişi giricek: 10 Kişi</option>
                    <option value="20">Kaç kişi giricek: 20 Kişi</option>
                </select>
            </div>
            <input type="text" id="lobbyNameInput" class="oval-box-input" placeholder="Lobi İsmi..." maxlength="25" />
            <button class="rect-box-btn" onclick="createLobbyConfirm()">Lobiyi Kur</button>
            <div style="margin-top: 16px;">
                <button onclick="backToMenuScene()" style="background:none; border:none; color:#94a3b8; cursor:pointer; font-weight:600;">← Geri Dön</button>
            </div>
        </div>
    </div>

    <!-- LOBİYE KATIL -->
    <div id="step-join-lobby" class="screen hidden">
        <div class="sketch-frame">
            <h2 class="sketch-title">Lobiye Katıl</h2>
            <input type="text" id="joinCodeInput" class="oval-box-input" placeholder="Lobi Kodu Girin..." style="text-transform: uppercase;" />
            <button class="rect-box-btn" onclick="joinLobbyConfirm()">Lobiye Gir</button>
            <div style="margin-top: 16px;">
                <button onclick="backToMenuScene()" style="background:none; border:none; color:#94a3b8; cursor:pointer; font-weight:600;">← Geri Dön</button>
            </div>
        </div>
    </div>

    <!-- 6. SAHNE: LOBİ BEKLEME -->
    <div id="step-lobby-room" class="screen hidden">
        <div class="sketch-frame wide">
            <div class="lobby-top-bar">
                <h2 id="roomLobbyTitle" style="font-size: 26px; font-weight: 800;">Lobi İsmi</h2>
                <div class="oval-code-box" style="padding: 8px 18px;">
                    <span id="roomCodeText" style="margin-right: 12px;">------</span>
                    <button onclick="copyLobbyCode()" style="background:#10b981; color:#000; border:none; padding:4px 10px; border-radius:6px; font-weight:800; cursor:pointer;">📋</button>
                </div>
            </div>
            <div class="lobby-grid">
                <div>
                    <h3 style="font-size: 18px; font-weight: 800; margin-bottom: 10px;">Lobiye Katılanlar</h3>
                    <div class="players-table">
                        <div class="players-table-head">
                            <span>İSİM</span>
                            <span>PUAN</span>
                        </div>
                        <div id="lobbyPlayerList"></div>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; justify-content: center;">
                    <div id="hostTargetBox" class="hidden">
                        <label style="font-size: 13px; font-weight: 800; color: #a5b4fc; display: block; margin-bottom: 8px;">TAHMİN EDİLECEK KİŞİYİ SEÇİN:</label>
                        <select id="targetSelectDropdown" class="rect-select-box" style="margin-bottom: 20px;"></select>
                        <button class="rect-box-btn" onclick="hostStartGame()" style="width: 100%; max-width: none; height: 90px; font-size: 26px; background: #10b981; color: #052e16;">Başlat</button>
                    </div>
                    <div id="guestWaitBox" class="hidden" style="border: 2px dashed rgba(255,255,255,0.25); padding: 30px; border-radius: 14px; text-align: center;">
                        <p style="font-size: 16px; font-weight: 700; color: #cbd5e1;">⏳ Lobi kurucusunun tahmin edilecek kişiyi seçip oyunu başlatması bekleniyor...</p>
                    </div>

                    <!-- LOBİDEN ÇIK BUTONU -->
                    <div style="margin-top: 20px; text-align: center;">
                        <button onclick="leaveLobby()" style="background:none; border:2px solid #ef4444; color:#ef4444; padding: 10px 20px; border-radius:8px; cursor:pointer; font-weight:700; width:100%;">🚪 Lobiden Çık ve Menüye Dön</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. SAHNE: OYUN -->
    <div id="step-quiz" class="screen hidden">
        <div class="sketch-frame wide">
            <div class="game-split-layout">
                <div class="game-left-panel">
                    <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 15px; margin-bottom: 10px;">
                        <span id="qCounterText">Soru 1 / 20</span>
                        <span id="myScoreText" style="color: #34d399;">Puanın: 0</span>
                    </div>
                    <div id="timerDisplay" style="border: 2px solid #e2e8f0; border-radius: 999px; padding: 6px 14px; text-align: center; font-weight: 800; font-size: 14px; color: #34d399; margin-bottom: 10px;">
                        Timer: 20 Saniye
                    </div>
                    <div id="targetPersonBanner" style="border: 1px solid #6366f1; background: rgba(99,102,241,0.15); padding: 8px; border-radius: 8px; text-align: center; font-weight: 700; font-size: 13px; margin-bottom: 12px; color: #c7d2fe;">
                        Tahmin Edilecek Kişi: ---
                    </div>
                    <div id="qTextDisplay" class="question-main-box">Soru yükleniyor...</div>
                    <div>
                        <button class="answer-opt-btn" id="opt-A" onclick="selectOption('A')">A: <span id="text-A"></span></button>
                        <button class="answer-opt-btn" id="opt-B" onclick="selectOption('B')">B: <span id="text-B"></span></button>
                        <button class="answer-opt-btn" id="opt-C" onclick="selectOption('C')">C: <span id="text-C"></span></button>
                        <button class="answer-opt-btn" id="opt-D" onclick="selectOption('D')">D: <span id="text-D"></span></button>
                    </div>
                    <div style="text-align: center; margin-top: 8px;">
                        <button id="btnFinalDecision" class="rect-box-btn" onclick="lockFinalDecision()" disabled style="max-width: 240px; padding: 12px 20px; font-size: 16px;">Son Kararım</button>
                    </div>
                    <div id="targetWhoGuessedBox" class="hidden" style="margin-top: 16px; border: 2px solid #f59e0b; border-radius: 10px; padding: 14px; background: rgba(245, 158, 11, 0.1);">
                        <label style="font-size: 13px; font-weight: 800; color: #fde68a; display: block; margin-bottom: 8px;">Cevabını kim doğru bildi? (+15p / -10p)</label>
                        <select id="whoGuessedSelect" class="rect-select-box" style="margin-bottom: 10px; padding: 10px; font-size: 14px;"></select>
                        <button class="rect-box-btn" onclick="submitTargetPrediction()" style="max-width: none; padding: 10px; font-size: 14px; background: #f59e0b; color: #000;">Seçimi Onayla ve Turu Bitir</button>
                    </div>
                    <p id="roundStatusText" style="margin-top: 12px; font-size: 14px; font-weight: 800; color: #fde68a; min-height: 20px; text-align: center;"></p>
                    <div style="margin-top: 18px; text-align: center; font-weight: 800; font-size: 13px; letter-spacing: 1.5px; color: #94a3b8;">
                        ALPER ÇAKIR GURURLA SUNAR
                    </div>
                </div>
                <div class="game-right-panel">
                    <h3 style="font-size: 22px; font-weight: 800; margin-bottom: 14px; text-align: center; border-bottom: 2px solid rgba(255,255,255,0.2); padding-bottom: 10px;">Sıralama</h3>
                    <div id="liveScoreboardList"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
            let myName = "";
            let currentLobbyCode = "";
            let currentLobbyName = "Gelin A Dostlar";
            let amIHost = false;
            let targetConnId = "";
            let tempSelectedOpt = null;
            let answerLocked = false;
            let countdownTimer = null;
            let timeLeft = 20;

            function switchSceneSmooth(fromId, toId) {
                const fromEl = document.getElementById(fromId);
                const toEl = document.getElementById(toId);
                fromEl.classList.add('fade-out');
                setTimeout(() => {
                    document.querySelectorAll('.screen').forEach(s => {
                        s.classList.add('hidden');
                        s.classList.remove('fade-out');
                    });
                    toEl.classList.remove('hidden');
                }, 500);
            }

            function showOnlyScreen(screenId) {
                document.querySelectorAll('.screen').forEach(s => {
                    s.classList.add('hidden');
                    s.classList.remove('fade-out');
                });
                document.getElementById(screenId).classList.remove('hidden');
            }

            function transitionFromSplashToInvite() {
                const splash = document.getElementById('step-splash');
                if (!splash.classList.contains('hidden')) {
                    switchSceneSmooth('step-splash', 'step-invite');
                }
            }

            function transitionToWelcome() {
                switchSceneSmooth('step-invite', 'step-welcome');
            }

            function goToMenuScene() {
                const val = document.getElementById('playerNameInput').value.trim();
                if (!val) { alert("Lütfen isminizi veya lakabınızı girin!"); return; }
                myName = val;
                showOnlyScreen('step-menu');
            }

            function openRulesScene() { showOnlyScreen('step-rules'); }
            function backToMenuScene() { showOnlyScreen('step-menu'); }
            function openJoinLobbyScene() { showOnlyScreen('step-join-lobby'); }

            function openCreateLobbyScene() {
                currentLobbyCode = Math.random().toString(36).substring(2, 8).toUpperCase();
                document.getElementById('generatedCodeText').innerText = currentLobbyCode;
                showOnlyScreen('step-create-lobby');
            }

            function copyLobbyCode() {
                navigator.clipboard.writeText(currentLobbyCode);
                alert("Lobi kodu kopyalandı: " + currentLobbyCode);
            }

            function leaveLobby() {
                if (confirm("Lobiden çıkmak istediğinize emin misiniz?")) {
                    currentLobbyCode = "";
                    amIHost = false;
                    showOnlyScreen('step-menu');
                }
            }

            const connection = new signalR.HubConnectionBuilder().withUrl("/lobbyHub").build();
            connection.start().catch(err => console.error(err.toString()));

            function renderScoreboards(players) {
                const lobbyList = document.getElementById('lobbyPlayerList');
                const targetDropdown = document.getElementById('targetSelectDropdown');
                const liveBoard = document.getElementById('liveScoreboardList');

                lobbyList.innerHTML = "";
                liveBoard.innerHTML = "";

                const prevSelected = targetDropdown.value;
                targetDropdown.innerHTML = "";

                const sorted = [...players].sort((a, b) => b.score - a.score);

                sorted.forEach(p => {
                    if (p.connectionId === connection.connectionId) {
                        document.getElementById('myScoreText').innerText = `Puanın: ${p.score}`;
                    }

                    const row = `<div class="player-row-item"><span>${p.isHost ? "👑 " : ""}${p.name}</span><span>${p.score} P</span></div>`;
                    lobbyList.innerHTML += row;
                    liveBoard.innerHTML += row;
                });

                players.forEach(p => {
                    const opt = document.createElement("option");
                    opt.value = p.connectionId;
                    opt.text = p.name;
                    targetDropdown.appendChild(opt);
                });

                if (prevSelected && [...targetDropdown.options].some(o => o.value === prevSelected)) {
                    targetDropdown.value = prevSelected;
                }
            }

            function createLobbyConfirm() {
                const lName = document.getElementById('lobbyNameInput').value.trim();
                currentLobbyName = lName ? lName : (myName + " Lobisi");
                amIHost = true;

                document.getElementById('roomLobbyTitle').innerText = currentLobbyName;
                document.getElementById('roomCodeText').innerText = currentLobbyCode;
                document.getElementById('hostTargetBox').classList.remove('hidden');
                document.getElementById('guestWaitBox').classList.add('hidden');

                showOnlyScreen('step-lobby-room');
                connection.invoke("JoinLobbyWithCode", currentLobbyCode, myName, true);
            }

            function joinLobbyConfirm() {
                const codeVal = document.getElementById('joinCodeInput').value.replace("KOD:", "").replace("#", "").trim().toUpperCase();
                if (!codeVal) { alert("Lütfen lobi kodunu girin!"); return; }
                currentLobbyCode = codeVal;
                amIHost = false;

                document.getElementById('roomLobbyTitle').innerText = "Lobi #" + currentLobbyCode;
                document.getElementById('roomCodeText').innerText = currentLobbyCode;
                document.getElementById('hostTargetBox').classList.add('hidden');
                document.getElementById('guestWaitBox').classList.remove('hidden');

                showOnlyScreen('step-lobby-room');
                connection.invoke("JoinLobbyWithCode", currentLobbyCode, myName, false);
            }

            connection.on("UpdatePlayerList", function (players) {
                renderScoreboards(players);
            });

            function hostStartGame() {
                const selectedTargetId = document.getElementById('targetSelectDropdown').value;
                if (!selectedTargetId) { alert("Lütfen tahmin edilecek kişiyi seçin!"); return; }
                connection.invoke("StartGameWithTarget", currentLobbyCode, selectedTargetId);
            }

            connection.on("ReceiveQuestion", function (q) {
                showOnlyScreen('step-quiz');
                targetConnId = q.targetConnectionId;
                tempSelectedOpt = null;
                answerLocked = false;

                if (q.players) {
                    renderScoreboards(q.players);
                }

                const amITarget = (connection.connectionId === targetConnId);

                document.getElementById('qCounterText').innerText = `Soru ${q.questionNumber} / ${q.totalQuestions}`;
                document.getElementById('targetPersonBanner').innerText = amITarget
                    ? `🎯 Tahmin Edilecek Kişi SENSİN (${q.targetName})`
                    : `Tahmin Edilecek Kişi: ${q.targetName}`;
                document.getElementById('qTextDisplay').innerText = q.questionText;
                document.getElementById('roundStatusText').innerText = "";
                document.getElementById('btnFinalDecision').disabled = true;
                document.getElementById('targetWhoGuessedBox').classList.add('hidden');

                ['A', 'B', 'C', 'D'].forEach(opt => {
                    const btn = document.getElementById(`opt-${opt}`);
                    btn.disabled = false;
                    btn.classList.remove('selected-opt');
                    document.getElementById(`text-${opt}`).innerText = q[`option${opt}`];
                });

                if (amITarget) {
                    const sel = document.getElementById('whoGuessedSelect');
                    sel.innerHTML = `<option value="NONE">Tahmin Yok (Risk Alma 0 Puan)</option>`;
                    q.players.forEach(p => {
                        if (p.connectionId !== connection.connectionId) {
                            sel.innerHTML += `<option value="${p.connectionId}">${p.name}</option>`;
                        }
                    });
                }

                startQuestionTimer();
            });

            function selectOption(opt) {
                if (answerLocked) return;
                tempSelectedOpt = opt;
                ['A', 'B', 'C', 'D'].forEach(o => document.getElementById(`opt-${o}`).classList.remove('selected-opt'));
                document.getElementById(`opt-${opt}`).classList.add('selected-opt');
                document.getElementById('btnFinalDecision').disabled = false;
            }

            function lockFinalDecision() {
                if (!tempSelectedOpt || answerLocked) return;
                answerLocked = true;
                ['A', 'B', 'C', 'D'].forEach(o => document.getElementById(`opt-${o}`).classList.remove('selected-opt'));
                document.getElementById('btnFinalDecision').disabled = true;

                connection.invoke("SubmitAnswerCode", currentLobbyCode, tempSelectedOpt);
                document.getElementById('roundStatusText').innerText = "🔒 Son kararın kilitlendi!";

                if (connection.connectionId === targetConnId) {
                    document.getElementById('targetWhoGuessedBox').classList.remove('hidden');
                }
            }

            function startQuestionTimer() {
                clearInterval(countdownTimer);
                timeLeft = 20;
                document.getElementById('timerDisplay').innerText = `Timer: ${timeLeft} Saniye`;

                countdownTimer = setInterval(() => {
                    timeLeft--;
                    document.getElementById('timerDisplay').innerText = `Timer: ${timeLeft} Saniye`;

                    if (timeLeft <= 0) {
                        clearInterval(countdownTimer);
                        if (!answerLocked && tempSelectedOpt) {
                            lockFinalDecision();
                        } else if (!answerLocked) {
                            ['A', 'B', 'C', 'D'].forEach(o => document.getElementById(`opt-${o}`).disabled = true);
                            document.getElementById('btnFinalDecision').disabled = true;
                        }

                        if (connection.connectionId === targetConnId) {
                            document.getElementById('targetWhoGuessedBox').classList.remove('hidden');
                            document.getElementById('roundStatusText').innerText = "⏰ Süre doldu! Cevabını kimin doğru bildiğini seç!";
                        } else {
                            document.getElementById('roundStatusText').innerText = "⏰ Süre doldu! Hedef kişinin tahmini bekleniyor...";
                        }
                    }
                }, 1000);
            }

            function submitTargetPrediction() {
                if (connection.connectionId !== targetConnId) return;
                const guessedPlayerId = document.getElementById('whoGuessedSelect').value;
                document.getElementById('targetWhoGuessedBox').classList.add('hidden');
                connection.invoke("EvaluateRoundAndScore", currentLobbyCode, guessedPlayerId);
            }

            connection.on("RoundResultAnnouncement", function (msg) {
                clearInterval(countdownTimer);
                document.getElementById('targetWhoGuessedBox').classList.add('hidden');
                document.getElementById('roundStatusText').innerText = msg;
            });

            connection.on("GameOver", function (sortedPlayers) {
                clearInterval(countdownTimer);
                alert("🏆 Oyun Bitti! 1. Olan: " + (sortedPlayers[0]?.name || "") + " (" + (sortedPlayers[0]?.score || 0) + " Puan)");

                showOnlyScreen('step-lobby-room');

                if (amIHost) {
                    document.getElementById('hostTargetBox').classList.remove('hidden');
                    document.getElementById('guestWaitBox').classList.add('hidden');
                } else {
                    document.getElementById('hostTargetBox').classList.add('hidden');
                    document.getElementById('guestWaitBox').classList.remove('hidden');
                }
            });
    </script>
</body>
</html>